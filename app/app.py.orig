)
def update_reference_power_curve(
    n_clicks,
    selected_filename,
    selected_turbine,
    cleaned_files_store,
    config_json_str,
):
    fig_pc = go.Figure()

    if not (selected_filename and cleaned_files_store):
        return fig_pc

